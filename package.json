{
  "name": "cndl-frontend",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/postbuild-standalone.mjs",
    "start": "node --env-file=.env.local .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "node --test tests/*.test.mts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
