# Copy to .env.local (runtime) — and put DATABASE_URL in .env too, which the
# Prisma CLI reads. Never commit real values.

# SQLite database — use an ABSOLUTE path in production.
DATABASE_URL="file:/var/www/cndl-frontend/prisma/dev.db"

# Signs admin session cookies and is the master login password. >= 32 chars.
ADMIN_SECRET=""

# Optional. Bearer token for machine-to-machine admin API calls (>= 32 chars).
# Leave empty to disable Bearer auth.
ADMIN_API_TOKEN=""

# Optional. Login identifier for the master account (default: admin).
MASTER_ADMIN_ID=""

# Optional. Project folder holding runtime data (uploads, case files).
# ecosystem.config.cjs sets this for PM2.
CNDL_APP_ROOT="/var/www/cndl-frontend"

# Optional. CNDL leads registry (JSONL), read by /api/admin/leads.
CNDL_LEADS_FILE="/var/lib/naeemmia-leads/prospects.jsonl"
